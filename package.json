{
  "name": "wally",
  "version": "1.0.0",
  "description": "Browser extension interaction recorder. Records browser and extension actions via Chrome CDP and exports standalone Playwright test scripts.",
  "main": "wally.js",
  "bin": {
    "wally": "./wally.js"
  },
  "scripts": {
    "start": "node wally.js",
    "snap": "node wally.js snap",
    "record": "node wally.js record",
    "daemon": "node wally.js daemon",
    "ext": "node wally.js ext",
    "export": "node wally.js export",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "browser-automation",
    "playwright",
    "chrome-cdp",
    "workflow-recorder",
    "testing",
    "extension",
    "chrome-extension",
    "har",
    "network-capture"
  ],
  "author": "Ignacio del Corro",
  "license": "BSD-3-Clause",
  "dependencies": {
    "playwright": "^1.50.0"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^30.0.1",
    "vitest": "^5.0.0"
  }
}
